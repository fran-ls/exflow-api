generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  username      String
  email         String         @unique
  password      String
  photoURL      String?        @map("photo_url")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  isActive      Boolean        @default(true) @map("is_active")
  role          Role           @default(USER)
  dailyStats    DailyStat[]
  monthlyStats  MonthlyStat[]
  refreshTokens RefreshToken[]
  transactions  Transaction[]
  wallets       Wallet[]
  yearlyStats   YearlyStat[]

  @@index([email])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  revoked   Boolean  @default(false)
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Wallet {
  id           String        @id @default(uuid())
  name         String
  type         WalletType
  balance      Float         @default(0)
  color        String
  income       Float         @default(0)
  expense      Float         @default(0)
  initBalance  Float         @default(0) @map("init_balance")
  incomeCount  Int           @default(0) @map("income_count")
  expenseCount Int           @default(0) @map("expense_count")
  userId       String        @map("user_id")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  transactions Transaction[]
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("wallets")
}

model Transaction {
  id          String          @id @default(uuid())
  title       String
  amount      Float
  description String?
  type        TransactionType
  date        DateTime
  time        String
  year        Int
  month       Int
  day         Int
  userId      String          @map("user_id")
  walletId    String          @map("wallet_id")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet      Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([walletId])
  @@map("transactions")
}

model DailyStat {
  id           String   @id @default(uuid())
  day          String
  date         DateTime
  income       Float    @default(0)
  expense      Float    @default(0)
  balance      Float    @default(0)
  incomeCount  Int      @default(0) @map("income_count")
  expenseCount Int      @default(0) @map("expense_count")
  userId       String   @map("user_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, day])
  @@map("daily_stats")
}

model MonthlyStat {
  id           String   @id @default(uuid())
  month        String
  income       Float    @default(0)
  expense      Float    @default(0)
  balance      Float    @default(0)
  incomeCount  Int      @default(0) @map("income_count")
  expenseCount Int      @default(0) @map("expense_count")
  userId       String   @map("user_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, month])
  @@map("monthly_stats")
}

model YearlyStat {
  id           String   @id @default(uuid())
  year         Int
  income       Float    @default(0)
  expense      Float    @default(0)
  balance      Float    @default(0)
  incomeCount  Int      @default(0) @map("income_count")
  expenseCount Int      @default(0) @map("expense_count")
  userId       String   @map("user_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, year])
  @@map("yearly_stats")
}

enum Role {
  USER
  ADMIN
}

enum WalletType {
  CASH
  BANK
  CREDIT_CARD
  SAVINGS
  INVESTMENT
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
}
